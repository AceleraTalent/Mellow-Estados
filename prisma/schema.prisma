generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ClientStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ClientStageStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
  PAUSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EntityType {
  CLIENT
  CLIENT_STAGE
  TASK
  TEAM
  USER
  STAGE
  TASK_TEMPLATE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(MEMBER)
  active       Boolean       @default(true)
  teamId       String?
  team         Team?         @relation(fields: [teamId], references: [id])
  ownedClients Client[]      @relation("ClientOwner")
  assignedTasks Task[]       @relation("TaskAssignee")
  createdTasks Task[]        @relation("TaskCreator")
  sessions     Session[]
  activities   ActivityLog[] @relation("ActivityActor")
  comments     Comment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([teamId])
  @@index([role, active])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  active      Boolean        @default(true)
  users       User[]
  clients     Client[]
  tasks       Task[]
  templates   TaskTemplate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Stage {
  id                  String         @id @default(cuid())
  name                String
  description         String?
  position            Int
  defaultDurationDays Int
  active              Boolean        @default(true)
  clientStages        ClientStage[]
  taskTemplates       TaskTemplate[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([position])
  @@index([active, position])
}

model Client {
  id                   String         @id @default(cuid())
  name                 String
  companyName          String
  email                String?
  phone                String?
  status               ClientStatus   @default(ACTIVE)
  ownerId              String?
  owner                User?          @relation("ClientOwner", fields: [ownerId], references: [id])
  teamId               String?
  team                 Team?          @relation(fields: [teamId], references: [id])
  startDate            DateTime
  currentClientStageId String?        @unique
  currentClientStage   ClientStage?   @relation("CurrentClientStage", fields: [currentClientStageId], references: [id])
  stages               ClientStage[]  @relation("ClientStages")
  tasks                Task[]
  comments             Comment[]
  activities           ActivityLog[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  archivedAt           DateTime?

  @@index([status, archivedAt])
  @@index([ownerId])
  @@index([teamId])
  @@index([startDate])
}

model ClientStage {
  id                   String            @id @default(cuid())
  clientId             String
  client               Client            @relation("ClientStages", fields: [clientId], references: [id], onDelete: Cascade)
  stageId              String
  stage                Stage             @relation(fields: [stageId], references: [id])
  currentForClient     Client?           @relation("CurrentClientStage")
  position             Int
  plannedStartDate     DateTime
  plannedEndDate       DateTime
  actualStartDate      DateTime?
  actualEndDate        DateTime?
  status               ClientStageStatus @default(NOT_STARTED)
  durationDaysSnapshot Int
  completedAt          DateTime?
  tasks                Task[]
  activities           ActivityLog[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([clientId, position])
  @@unique([clientId, stageId])
  @@index([clientId, status])
  @@index([status, plannedEndDate])
  @@index([stageId])
}

model TaskTemplate {
  id                    String       @id @default(cuid())
  stageId               String
  stage                 Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  priority              TaskPriority @default(MEDIUM)
  defaultAssignedUserId String?
  defaultAssignedTeamId String?
  defaultAssignedTeam   Team?        @relation(fields: [defaultAssignedTeamId], references: [id])
  startOffsetDays       Int          @default(0)
  dueOffsetDays         Int          @default(3)
  sortOrder             Int          @default(0)
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([stageId, active, sortOrder])
  @@index([defaultAssignedTeamId])
}

model Task {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientStageId  String
  clientStage    ClientStage  @relation(fields: [clientStageId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  assignedUserId String?
  assignedUser   User?        @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  assignedTeamId String?
  assignedTeam   Team?        @relation(fields: [assignedTeamId], references: [id])
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  sortOrder      Int          @default(0)
  createdById    String?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id])
  comments       Comment[]
  activities     ActivityLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?

  @@index([clientId])
  @@index([clientStageId])
  @@index([status, dueDate])
  @@index([assignedUserId, status])
  @@index([assignedTeamId, status])
  @@index([clientStageId, sortOrder])
}

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  clientId   String?
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  author     User       @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  archivedAt DateTime?

  @@index([entityType, entityId, createdAt])
  @@index([clientId, createdAt])
  @@index([taskId, createdAt])
}

model ActivityLog {
  id            String     @id @default(cuid())
  actorId       String?
  actor         User?      @relation("ActivityActor", fields: [actorId], references: [id])
  action        String
  entityType    EntityType
  entityId      String
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientStageId String?
  clientStage   ClientStage? @relation(fields: [clientStageId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime   @default(now())

  @@index([clientId, createdAt])
  @@index([taskId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
